        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    // Add your code here
    if (current.state == -5) { // On Hold

        var inc = new GlideRecord('incident');

        inc.initialize();

        inc.short_description = 'License unavailable for ' + current.variables.what_software_do_you_need.getValue();

        inc.description = 'Software request could not be fulfilled due to license shortage.';

        inc.caller_id = current.request.requested_for;

        inc.assignment_group.setDisplayValue('Software');

